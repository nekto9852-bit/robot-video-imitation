<?xml version="1.0"?>
<!-- Описание 6-DOF руки для robot_state_publisher и ros2_control.
     Кинематика соответствует MJCF arm_6dof.xml (оси/лимиты — в рад).
     hardware выбирается аргументом:
       hardware:=mock  -> mock_components/GenericSystem (официальный ros2_control fallback)
       hardware:=mujoco -> mujoco_ros2_control/MujocoSystem + MJCF arm_6dof.xml
     ВНИМАНИЕ: имена параметров mujoco_ros2_control сверять с версией пакета
     (README_ros2.md — раздел совместимости). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm6dof">
  <xacro:arg name="hardware" default="mujoco"/>
  <xacro:arg name="mujoco_model_path" default="arm_6dof.xml"/>

  <xacro:macro name="joint_interfaces">
    <joint name="j1_base_yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j2_shoulder_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j3_shoulder_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j4_elbow">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j5_wrist_pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j6_wrist_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <link name="world"/>
  <link name="base_link"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="link1"/>
  <joint name="j1_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.96706" upper="2.96706" effort="50" velocity="2.0"/>
  </joint>

  <link name="link2"/>
  <joint name="j2_shoulder_pitch" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.96706" upper="2.96706" effort="50" velocity="2.0"/>
  </joint>

  <link name="link3"/>
  <joint name="j3_shoulder_roll" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.91986" upper="1.91986" effort="40" velocity="2.0"/>
  </joint>

  <link name="link4"/>
  <joint name="j4_elbow" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.61799" upper="2.61799" effort="35" velocity="2.0"/>
  </joint>

  <link name="link5"/>
  <joint name="j5_wrist_pitch" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.91986" upper="1.91986" effort="20" velocity="2.0"/>
  </joint>

  <link name="link6"/>
  <joint name="j6_wrist_roll" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="12" velocity="2.0"/>
  </joint>

  <link name="tool_link"/>
  <joint name="tool_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <xacro:if value="${'$(arg hardware)' == 'mock'}">
    <ros2_control name="MockSystem" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <xacro:joint_interfaces/>
    </ros2_control>
  </xacro:if>

  <xacro:if value="${'$(arg hardware)' == 'mujoco'}">
    <ros2_control name="MujocoSystem" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        <param name="mujoco_model_path">$(arg mujoco_model_path)</param>
      </hardware>
      <xacro:joint_interfaces/>
    </ros2_control>
  </xacro:if>
</robot>
